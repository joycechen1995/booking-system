# 伺服器啟動的通訊埠
PORT=3000

# --- 寄信設定（SMTP）---------------------------------------------------------
# 若使用 Gmail：SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# SMTP_USER 填你的 Gmail 帳號，SMTP_PASS 請用「應用程式密碼」而非登入密碼
# （Google 帳號 -> 安全性 -> 兩步驟驗證 -> 應用程式密碼）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# 收到「新預約通知」的信箱（通常填你自己）
ADMIN_NOTIFY_EMAIL=you@gmail.com

# --- Google Meet / 行事曆整合（選填，不填則不會產生會議連結）-------------------
# 需要到 Google Cloud Console 建立 OAuth Client ID（見 README），
# 取得 CLIENT_ID / CLIENT_SECRET 後，執行 `node authorize-google.js` 取得 REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
